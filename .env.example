# ---------------------------------------------------------------- frontend
# Browser-side API base. Leave empty when Nginx serves the API on the same
# origin under /api, so the admin session cookie stays same-origin.
NEXT_PUBLIC_API_BASE_URL=
# Server-rendering API base. Points at the API service on loopback.
API_INTERNAL_BASE_URL=http://127.0.0.1:39300

# ----------------------------------------------------------------- api/
# Required. The API never falls back to static content.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/xmhua
API_PORT=39300
API_HOST=127.0.0.1
DB_POOL_MAX=8
DEFAULT_TENANT_SLUG=xmhua

# Console sessions. Set ADMIN_COOKIE_SECURE=false only for plain-HTTP local dev.
ADMIN_SESSION_TTL_HOURS=336
ADMIN_COOKIE_SECURE=true
# Optional machine credential for scripts and CI. Console login does not need it.
ADMIN_API_KEY=

# Cross-origin console (comma separated). Not needed for same-origin deploys.
CORS_ALLOWED_ORIGIN=

# Multi-tenant self-service. Disabled by default; the public blog does not link it.
SELF_SERVICE_SIGNUP_ENABLED=false
SIGNUP_INVITE_CODE=
SIGNUP_RATE_LIMIT=5
SIGNUP_RATE_WINDOW_SECONDS=900
MAX_TENANTS=100
TRUST_PROXY_HEADERS=false
