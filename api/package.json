{
  "name": "xmhua-api",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone content API for the XMHUA personal blog. Owns PostgreSQL, authentication and all writes.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/seed.ts",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "security:check": "tsx src/scripts/security-regression.ts",
    "check": "npm run typecheck && npm run security:check && npm run build",
    "dev:db": "tsx src/scripts/dev-database.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.0",
    "postgres": "^3.4.5",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/node": "^24.3.0",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "esbuild": "^0.25.10"
  }
}
